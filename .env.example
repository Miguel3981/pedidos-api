# Copie este arquivo para ".env" caso queira rodar a aplicação fora do
# docker-compose (ex.: localmente com Python). Ao usar "docker compose up",
# essas variáveis já são definidas automaticamente pelo docker-compose.yml.

# String de conexão com o PostgreSQL: usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://pedidos:pedidos@postgres:5432/pedidos
